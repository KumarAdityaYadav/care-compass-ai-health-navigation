# CareCompass Environment Configuration

# GEMINI_API_KEY: Server-side Gemini AI API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Recommended official Gemini model for multi-turn healthcare triage
GEMINI_MODEL="gemini-3.8-flash"

# TINYFISH_API_KEY: TinyFish Doctor Teleconsultation Web Automation / Search API Key
# Production key provided for HACK IIITD
TINYFISH_API_KEY="YOUR_TINYFISH_API_KEY"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT=3000

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
